# This .gitignore file should be placed at the root of your Unity project directory

# Assets folder should only contain source files (scripts, art, etc.)
# Library and Temp are Unity's local caches
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory dumps
*.DS_Store
*.swo
*.swp
*.pid
*.log

# Visual Studio / VS Code / Rider
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider
.idea/

# VS Code
.vscode/

# Unity specific
*.unitypackage
*.asset
*.meta
*.prefab
*.unity
*.anim
*.controller
*.overrideController
*.mask
*.mat
*.cubemap
*.flare
*.renderTexture
*.guiskin
*.fontsettings
*.giparams
*.lighting
*.asset
*.physicMaterial
*.physicsMaterial2D
*.terrainlayer
*.brush
*.sound
*.mixer
*.exr
*.tga
*.tif
*.tiff
*.psd

# Autogenerated JetBrains Rider
.idea/
*.sln.iml

# Autogenerated ASP.NET Core
/wwwroot/
/appsettings.json
/appsettings.Development.json
/Properties/launchSettings.json

# The crashReport folder is created by Unity when a crash occurs
/CrashReport/

# The Build folder is the default output folder when building
/Build/

# The AutoSave folder is created by Unity when auto-saving scenes
/AutoSave/