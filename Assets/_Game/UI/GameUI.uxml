<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="root-container" style="flex-grow: 1; flex-direction: column;">
        
        <!-- HUD -->
        <ui:VisualElement name="hud" style="height: 60px; flex-direction: row; background-color: rgba(10, 15, 30, 0.95); align-items: center; padding-left: 15px; padding-right: 15px;">
            <ui:Label name="company-label" text="Mi Empresa" style="font-size: 18px; color: rgb(232, 237, 245);" />
            <ui:Label name="date-label" text="01/01/2025" style="font-size: 14px; color: rgb(180, 200, 230); margin-left: 20px;" />
            <ui:Label name="money-label" text="$5.000" style="font-size: 18px; color: rgb(0, 200, 80); margin-left: 20px;" />
            <ui:Label name="reputation-label" text="Rep: 50/100" style="font-size: 14px; color: rgb(255, 200, 100); margin-left: 20px;" />
            <ui:Label name="level-label" text="Nv. 1" style="font-size: 14px; color: rgb(100, 180, 255); margin-left: 20px;" />
            <ui:VisualElement style="flex-grow: 1;" />
            <ui:Button name="pause-btn" text="⏸" style="width: 40px;" />
            <ui:Button name="speed1-btn" text="x1" style="width: 40px; margin-left: 5px;" />
            <ui:Button name="speed2-btn" text="x2" style="width: 40px; margin-left: 5px;" />
            <ui:Button name="speed3-btn" text="x3" style="width: 40px; margin-left: 5px;" />
        </ui:VisualElement>
        
        <!-- TABS + PANEL -->
        <ui:VisualElement name="main-container" style="flex-grow: 1; flex-direction: row;">
            <ui:VisualElement name="tabs-container" style="width: 130px; background-color: rgba(15, 25, 40, 0.9);">
                <ui:Button name="tab-market" text="📦 Mercado" style="margin-top: 10px; padding: 8px;" />
                <ui:Button name="tab-active" text="🚢 Activas" style="margin-top: 5px; padding: 8px;" />
                <ui:Button name="tab-finances" text="💰 Finanzas" style="margin-top: 5px; padding: 8px;" />
                <ui:Button name="tab-offices" text="🏢 Oficinas" style="margin-top: 5px; padding: 8px;" />
                <ui:Button name="tab-agents" text="🤝 Agentes" style="margin-top: 5px; padding: 8px;" />
                <ui:Button name="tab-clients" text="👤 Clientes" style="margin-top: 5px; padding: 8px;" />
                <ui:Button name="tab-map" text="🌍 Mapa" style="margin-top: 5px; padding: 8px;" />
            </ui:VisualElement>
            
            <ui:VisualElement name="panel-container" style="flex-grow: 1; background-color: rgba(8, 12, 20, 0.85); padding: 15px;">
                <ui:Label name="panel-title" text="Bienvenido" style="font-size: 20px; color: rgb(100, 180, 255); margin-bottom: 15px;" />
                <ui:ScrollView name="panel-content" style="flex-grow: 1;" />
            </ui:VisualElement>
        </ui:VisualElement>
        
        <!-- NEWS TICKER -->
        <ui:VisualElement name="news-ticker" style="height: 32px; background-color: rgba(0, 0, 0, 0.7); flex-direction: row; align-items: center; padding-left: 10px;">
            <ui:Label name="news-label" text="📰 Bienvenido a Freight Forwarder" style="font-size: 12px; color: rgb(200, 210, 230);" />
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>